node_modules/
dist/
coverage/
.cache/
*.log
.DS_Store

# Local tooling state (may embed absolute paths). The config is the exception: it records what
# this repo asks its gates to do, so it has to travel with the repo — a gate choice that lives
# on one machine is a gate everyone else silently does not have. The `/*` form is required;
# git will not re-include a file underneath an excluded directory.
.etymd/*
!.etymd/config.json

# Local end-to-end validation: a real Storybook build and its dependencies.
# Reproduced from instructions, never committed.
.validation/

# Session scaffolding — internal, never published.
# Delete both once v1 builds.
HANDOFF.md
NEXT-SESSION.md

# Machine-local companion hooks and scratch; never tracked. Anchored to the root
# so a directory named local deeper in the tree cannot silently become untrackable.
/local/
