node_modules/
dist/
coverage/
.cache/
*.log
.DS_Store

# State written by the git-hook generator named in the README; only its config travels with the
# repo. The `/*` form is required: git will not re-include a file under an excluded directory.
.etymd/*
!.etymd/config.json

# Local end-to-end validation: a real Storybook build and its dependencies.
# Reproduced from instructions, never committed.
.validation/

# Machine-local companion hooks, run by the tracked `.githooks/*.local` runners; never tracked.
# Anchored to the root so a directory named local deeper in the tree stays trackable.
/local/
