#!/usr/bin/env sh
# Machine-local companion checks, when this machine has any: local/hooks/commit-msg at the main
# checkout's root, gitignored and never tracked. It runs first, with this hook's arguments and
# stdin; a contributor without one proceeds exactly as before. (published-surface stub)
COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || COMMON_DIR=""
COMPANION="${COMMON_DIR%/.git}/local/hooks/commit-msg"
if [ -n "$COMMON_DIR" ] && [ -x "$COMPANION" ]; then
  "$COMPANION" "$@" || exit 1
fi

exit 0
