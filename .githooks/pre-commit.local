#!/usr/bin/env sh
# Machine-local companion checks, when this machine has any: local/hooks/pre-commit at the main
# checkout's root, gitignored and never tracked. It runs before the project-owned checks below
# and gets this hook's arguments. A checkout without a companion tree skips straight to them —
# what a companion runs is private to the machine that wrote it.
COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || COMMON_DIR=""
# The companion path derivation, and the layouts it covers, are documented in commit-msg.local.
COMPANION="${COMMON_DIR%/.git}/local/hooks/pre-commit"
if [ -x "$COMPANION" ]; then
  "$COMPANION" "$@" || exit 1
elif [ -e "$COMPANION" ]; then
  echo "warning: $COMPANION exists but is not executable — skipped" >&2
fi

# Project-owned pre-commit guards. etymd never reads or regenerates this file.

# The report's behaviour is a string of client-side JavaScript that only runs once a browser
# has parsed it, so the unit suite can assert it was emitted and nothing more. Drive it in a
# real browser instead — but only on the commits that could have broken it, because the check
# launches Chromium and no other commit should pay for that.
#
# Bypass, with a reason: git commit --no-verify
if git diff --cached --name-only | grep -qE '^(src/report/|scripts/report-check\.mjs)'; then
  echo "› report changed — driving it in a browser"
  npm run --silent check:report || exit 1
fi

exit 0
