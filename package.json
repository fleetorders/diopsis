{
  "name": "diopsis",
  "version": "0.2.0",
  "description": "Visual regression for Storybook — diffs the static build; identical locally and in CI.",
  "type": "module",
  "license": "MIT",
  "author": "Alkis Yuv <hello@yuv.run>",
  "keywords": [
    "storybook",
    "visual-regression",
    "visual-testing",
    "screenshot-testing",
    "playwright",
    "snapshot",
    "ci",
    "diff"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fleetorders/diopsis.git"
  },
  "homepage": "https://github.com/fleetorders/diopsis#readme",
  "bugs": {
    "url": "https://github.com/fleetorders/diopsis/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "diopsis": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run typecheck && node --test \"test/**/*.test.ts\"",
    "check:report": "node scripts/report-check.mjs",
    "prepublishOnly": "./scripts/artifact-check.sh",
    "changeset": "changeset",
    "version:packages": "changeset version"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@playwright/test": "1.62.1",
    "@types/node": "22.10.2",
    "typescript": "7.0.2"
  }
}
